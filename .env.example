# Copy to .env and fill in. Never commit .env.

# Zerodha (Kite Connect)
ZERODHA_API_KEY=
ZERODHA_API_SECRET=

# Dhan (DhanHQ)
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Alpaca
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# Email (SMTP — e.g. Gmail with an app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# SEC EDGAR (US fundamentals) — "AppName your@email.com"
SEC_USER_AGENT=

# Telegram phone alerts (optional): create a bot with @BotFather, then run: trademare notify telegram-setup
TELEGRAM_BOT_TOKEN=

# LLM (optional)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Dashboard login
DASHBOARD_PASSWORD=
